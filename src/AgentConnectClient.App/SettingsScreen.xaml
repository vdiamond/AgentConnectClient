<UserControl x:Class="AgentConnectClient.App.SettingsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock Text="MCP server URL"/>
      <TextBox x:Name="McpUrlBox" Margin="0,4,0,10"/>
      <TextBlock Text="REST base URL"/>
      <TextBox x:Name="RestUrlBox" Margin="0,4,0,10"/>
      <TextBlock Text="Admin key"/>
      <PasswordBox x:Name="AdminKeyBox" Margin="0,4,0,10"/>
      <TextBlock Text="Saved tokens" FontWeight="SemiBold" Margin="0,8,0,4"/>
      <ListBox x:Name="TokenList" Height="180" Margin="0,0,0,8">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Right" Text="••••••••" Margin="16,0,0,0" Foreground="#6B7280"/>
              <TextBlock Text="{Binding}"/>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Button Content="Remove" HorizontalAlignment="Left" Click="Remove_Click"/>
      <TextBlock Text="Add token" FontWeight="SemiBold" Margin="0,16,0,4"/>
      <PasswordBox x:Name="NewTokenBox" Margin="0,0,0,8"/>
      <TextBlock Text="Description"/>
      <TextBox x:Name="NewDescriptionBox" Margin="0,4,0,8"/>
      <Button Content="Add token" HorizontalAlignment="Left" Click="Add_Click"/>
      <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
        <Button Content="Save" Click="Save_Click" Background="#2563EB" Foreground="White" BorderBrush="#2563EB"/>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#6B7280"/>
      </StackPanel>
      <TextBlock Text="Settings file" Margin="0,8,0,4"/>
      <TextBlock x:Name="FilePathText" TextWrapping="Wrap" Foreground="#6B7280"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
