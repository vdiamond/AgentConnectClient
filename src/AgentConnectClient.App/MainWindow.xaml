<Window x:Class="AgentConnectClient.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AgentConnectClient.App"
        Title="AgentConnectClient"
        Width="1120"
        Height="780"
        MinWidth="860"
        MinHeight="640"
        Background="#F4F5F7"
        FontFamily="Segoe UI"
        FontSize="14">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#1F2933" Padding="12,8">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="McpButton" Content="MCP" Click="ShowMcp_Click" Margin="0,0,8,0"/>
        <Button x:Name="RestButton" Content="REST" Click="ShowRest_Click" Margin="0,0,8,0"/>
        <Button x:Name="SettingsButton" Content="Settings" Click="ShowSettings_Click"/>
      </StackPanel>
    </Border>
    <Grid>
      <local:CallScreen x:Name="McpScreen"/>
      <local:CallScreen x:Name="RestScreen" Visibility="Collapsed"/>
      <local:SettingsScreen x:Name="SettingsView" Visibility="Collapsed" Background="#F4F5F7"/>
    </Grid>
  </DockPanel>
</Window>
