<Application x:Class="AgentConnectClient.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#F4F5F7"/>
    <SolidColorBrush x:Key="InkBrush" Color="#1F2933"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="#E5E7EB"/>
      <Setter Property="Foreground" Value="#1F2933"/>
      <Setter Property="BorderBrush" Value="#D1D5DB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="BorderBrush" Value="#D1D5DB"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="BorderBrush" Value="#D1D5DB"/>
    </Style>
  </Application.Resources>
</Application>
